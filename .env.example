# ---- PlayNora -> Java Spring Boot backend ----
# RECOMMENDED (same-origin proxy, no CORS, httpOnly cookies just work):
#   leave NEXT_PUBLIC_API_URL empty and set BACKEND_URL. next.config.mjs rewrites /api/* to it.
BACKEND_URL=http://localhost:8080
# DIRECT mode (browser calls backend; backend must enable CORS with credentials):
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1

# Name of the session cookie the backend sets (httpOnly). Used ONLY by the route-guard
# middleware as a UX hint. Set to empty to disable the middleware hint.
NEXT_PUBLIC_SESSION_COOKIE=pn_session

# DEV ONLY: serve sample data and accept a mock admin login. Hard-disabled in production builds.
NEXT_PUBLIC_USE_MOCK=true

# DEV ONLY: restrict the mock login to one account (put real values in .env.local, not here)
NEXT_PUBLIC_MOCK_ADMIN_EMAIL=
NEXT_PUBLIC_MOCK_ADMIN_PASSWORD=
